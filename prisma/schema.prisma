generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Position {
  GK
  DEF
  MID
  ATT
}

enum EventCardType {
  ADD_CAPITAL
  DEDUCT_CAPITAL
  REMOVE_PLAYER
  SELL_PLAYER_FOR_AMOUNT
  FREE_PLAYER
  CUSTOM
}

model Team {
  id          String   @id @default(cuid())
  name        String
  color       String
  capital     Float    @default(100)
  baseCapital Float    @default(100)
  quizCapital Float    @default(0)
  totalOVR    Int      @default(0)
  logoUrl     String?
  transferBan Boolean  @default(false)
  players     Player[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Player {
  id        String    @id @default(cuid())
  name      String
  position  Position
  ovr       Int
  basePrice Float
  soldPrice Float?
  sold      Boolean   @default(false)
  teamId    String?
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, position])
}

model EventCard {
  id          String        @id @default(cuid())
  name        String        @unique
  type        EventCardType
  amount      Float?
  description String
  enabled     Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AuctionHistory {
  id         String   @id @default(cuid())
  actionType String
  timestamp  DateTime @default(now())
  payload    Json
}

model EventCardHistory {
  id        String   @id @default(cuid())
  cardName  String
  effect    String
  teamId    String?
  timestamp DateTime @default(now())
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  role          String          @default("PUBLIC")
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
